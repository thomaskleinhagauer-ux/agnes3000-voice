# AGNES 3000 Server Environment Variables
# On Railway: set these in the Railway dashboard

# Claude API (Anthropic) - server-side proxy
ANTHROPIC_API_KEY=sk-ant-api03-...

# Gemini API (Google) - server-side proxy for TTS + chat
GEMINI_API_KEY=AIzaSy...

# Server config
PORT=3000
NODE_ENV=production

# Legacy: Vite frontend (still used for direct API calls during migration)
VITE_CLAUDE_API_KEY=your-claude-api-key-here
VITE_GEMINI_API_KEY=your-gemini-api-key-here
